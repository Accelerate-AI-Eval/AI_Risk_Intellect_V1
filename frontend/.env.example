# Optional. No trailing slash. Include the versioned API path, e.g.:
#   VITE_BASE_URL=http://localhost:5005/api/v1
# Code joins this with paths like `/auth/login` → `http://localhost:5005/api/v1/auth/login`.
# If unset, requests use relative paths only (set this for a predictable dev setup).
VITE_BASE_URL=http://localhost:5005/api/v1
